# =========================
# DATABASE
# =========================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ganpati_vargani
DB_USERNAME=root
DB_PASSWORD=

# =========================
# SERVER / APP
# =========================
SERVER_PORT=8080
ORGANIZATION_NAME=Ganpati Mandal
CORS_ALLOWED_ORIGINS=http://localhost:5173

# =========================
# AUTH
# =========================
# JWT_SECRET must be a random string, 32+ characters. Generate with:
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_HOURS=12

# Creates the first admin account on startup if no admin exists yet.
# Change the password immediately after first login, then these two
# variables are no longer used (safe to leave in .env or remove).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Extra password for POST /api/debug-controller-4719/clear-data (also requires admin JWT).
# Leave blank to disable. Clears donations/contributors/broadcasts/audit — keeps templates.
DEBUG_CLEAR_PASSWORD=

# =========================
# WHATSAPP (Meta Cloud API)
# =========================
# provider = mock (safe default, logs messages instead of sending)
#          | meta-cloud-api (real sends - requires all fields below)
WHATSAPP_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0

# Shown to Meta as the "Verify token" when configuring the webhook Callback
# URL. Make up any random string - it just has to match on both sides.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# =========================
# LOGGING
# =========================
LOG_LEVEL=INFO
JPA_SHOW_SQL=false
WHATSAPP_APP_ID=
