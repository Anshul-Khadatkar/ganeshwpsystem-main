# Used by docker-compose.yml. Copy to .env in the project root before
# running `docker compose up`.

# Local Docker MySQL: leave DB_HOST empty/mysql and use:
#   docker compose --profile with-mysql up -d
# AWS RDS: set DB_HOST to the RDS endpoint, DB_USERNAME to the RDS master user,
# then: docker compose up -d backend   (do NOT start the mysql container)

DB_HOST=mysql
DB_PORT=3306
DB_NAME=ganpati_vargani
DB_USERNAME=root
DB_PASSWORD=changeme_use_a_real_password

ORGANIZATION_NAME=Ganpati Mandal
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_HOURS=12

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_before_first_run

# Extra password for POST /api/debug-controller-4719/clear-data (admin JWT also required).
DEBUG_CLEAR_PASSWORD=

WHATSAPP_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_ID=
